# VYBE API — copy this to .env and fill in your values

# Port to run the API on (default: 3002)
PORT=3002

# Supabase PostgreSQL connection string
# Get from: Supabase dashboard → Project Settings → Database → Connection string → URI
VYBE_DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Clerk secret key
# Get from: clerk.com → Your App → API Keys → Secret keys
CLERK_SECRET_KEY=sk_live_...

# Supabase service role key (for server-side file uploads)
# Get from: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_URL=https://[YOUR_PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL of the frontend (for CORS)
VYBE_FRONTEND_URL=http://localhost:3001

# Log level (optional, default: info)
LOG_LEVEL=info

# Stripe (optional — payment integration)
# Get from: dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
# Get from: dashboard.stripe.com → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Twilio (optional — SMS notifications)
# Get from: console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
