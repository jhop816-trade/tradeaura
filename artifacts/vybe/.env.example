# VYBE Frontend — copy this to .env and fill in your values

# Port to run the frontend on (default: 3001)
PORT=3001

# URL of the VYBE API (in dev, Vite proxy handles this — leave empty)
# In production, set to your deployed API URL
VYBE_API_URL=

# Clerk publishable key
# Get from: clerk.com → Your App → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Supabase credentials (for direct client-side file uploads, optional)
# Get from: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://[YOUR_PROJECT].supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
