# Anthropic
ANTHROPIC_API_KEY=

# Supabase (use SERVICE_ROLE key — not anon key)
# Use a NEW Supabase project, separate from GID/TradeAura's.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — create a new bot via @BotFather in Telegram, separate from GID's bot.
# TELEGRAM_CHAT_ID: message your new bot once, then hit
# https://api.telegram.org/bot<token>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JuFade
JUFADE_URL=https://jufaded.com

