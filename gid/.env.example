# Anthropic
ANTHROPIC_API_KEY=

# Supabase (use SERVICE_ROLE key — not anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta (Facebook + Instagram)
# Facebook cross-post is handled automatically via Instagram's built-in crosspost setting
META_PAGE_ID=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_DEFAULT_IMAGE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TradeAura
TRADEAURA_URL=https://tradeaura.com

# Posting behavior
# Set to true to post immediately without Telegram approval. Default false = always ask.
AUTO_POST=false
