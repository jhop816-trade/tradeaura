{
  "installCommand": "cd artifacts/tradeaura && npm install",
  "buildCommand": "cd artifacts/tradeaura && npx vite build --config vite.config.ts",
  "outputDirectory": "artifacts/tradeaura/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tradeaura-api-server.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
