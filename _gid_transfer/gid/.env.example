# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never exposed to the browser. Used for
# writing/reading the activity log and any future privileged operations.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the chat command center
ANTHROPIC_API_KEY=
